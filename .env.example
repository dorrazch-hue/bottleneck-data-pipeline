# Copiez ce fichier en ".env" et remplissez vos propres valeurs.
# Le fichier ".env" ne doit JAMAIS être commité (il est dans .gitignore).

# Mot de passe de la base PostgreSQL utilisée en interne par Kestra
POSTGRES_PASSWORD=changez_moi

# Identifiants de connexion à l'interface Kestra (créés au premier lancement)
KESTRA_USERNAME=votre.email@exemple.com
KESTRA_PASSWORD=UnMotDePasseSolide1
